# Architecture
BR2_riscv=y
BR2_RISCV_64=y

# System
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PROPELLER_PATH)/board/beaglev/rootfs_overlay"

# Toolchain
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.1"
BR2_LINUX_KERNEL_DEFCONFIG="defconfig"
BR2_LINUX_KERNEL_DTS_SUPPORT=y

# Filesystem
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y

# Packages
BR2_PACKAGE_WAMR=y
BR2_PACKAGE_PROPLET=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBCURL=y

# Init system
BR2_INIT_SYSTEMD=y

# Network
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_OPENSSH=y

# Build options
BR2_ENABLE_DEBUG=y
BR2_OPTIMIZE_2=y