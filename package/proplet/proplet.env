# Proplet Configuration for BeagleV
# Edit this file with your laptop's IP address and credentials

# ============================================================================
# LAPTOP/SERVER CONNECTION (REQUIRED - UPDATE THESE!)
# ============================================================================

# Your laptop's IP address on the Ethernet network
# Example: If your laptop is 192.168.1.100, set this to that IP
SUPERMQ_BROKER_HOST=192.168.1.100
SUPERMQ_BROKER_PORT=1883

# SuperMQ MQTT broker URL
# Format: tcp://LAPTOP_IP:PORT or mqtt://LAPTOP_IP:PORT
SUPERMQ_BROKER_URL=tcp://${SUPERMQ_BROKER_HOST}:${SUPERMQ_BROKER_PORT}

# SuperMQ authentication
# These should match what you configured in SuperMQ on your laptop
SUPERMQ_USERNAME=proplet
SUPERMQ_PASSWORD=changeme

# MQTT client ID - make this unique per device
SUPERMQ_CLIENT_ID=proplet-beaglev-001

# ============================================================================
# PROPLET IDENTIFICATION
# ============================================================================

PROPLET_ID=beaglev-001
PROPLET_NAME="BeagleV RISC-V Edge Device"
PROPLET_TYPE=edge

# ============================================================================
# MQTT TOPICS
# ============================================================================

# Topics for communication with Propeller Manager
PROPLET_COMMAND_TOPIC=propeller/proplet/${PROPLET_ID}/command
PROPLET_STATUS_TOPIC=propeller/proplet/${PROPLET_ID}/status
PROPLET_RESULT_TOPIC=propeller/proplet/${PROPLET_ID}/result
PROPLET_HEARTBEAT_TOPIC=propeller/proplet/${PROPLET_ID}/heartbeat

# MQTT QoS level: 0, 1, or 2
MQTT_QOS=1
MQTT_KEEP_ALIVE=60
MQTT_CLEAN_SESSION=false

# ============================================================================
# WASMTIME CONFIGURATION
# ============================================================================

# Cache directory for compiled WASM modules
WASMTIME_CACHE_DIR=/var/lib/proplet/wasm-cache

# Memory limits per WASM instance
WASM_MAX_MEMORY=134217728  # 128MB in bytes
WASM_STACK_SIZE=2097152    # 2MB in bytes

# Maximum concurrent WASM instances
WASM_MAX_INSTANCES=5

# Execution timeout (in seconds, 0 = no timeout)
WASM_TIMEOUT=300

# Enable WASI (WebAssembly System Interface)
WASI_ENABLED=true

# ============================================================================
# WORKLOAD STORAGE
# ============================================================================

# Local storage paths
WORKLOAD_DIR=/var/lib/proplet/workloads
DATA_DIR=/var/lib/proplet/data
TEMP_DIR=/tmp/proplet

# Auto-cleanup old workloads
AUTO_CLEANUP=true
RETENTION_DAYS=7

# ============================================================================
# LOGGING
# ============================================================================

# Log level: trace, debug, info, warn, error
LOG_LEVEL=info

# Log format: json or text
LOG_FORMAT=text

# Log output: stdout, stderr, or file path
LOG_OUTPUT=stdout

# If logging to file:
LOG_FILE=/var/log/proplet/proplet.log
LOG_MAX_SIZE=100M
LOG_MAX_BACKUPS=5

# ============================================================================
# SECURITY
# ============================================================================

# TLS/SSL configuration (if your SuperMQ uses TLS)
TLS_ENABLED=false
TLS_CA_CERT=/etc/proplet/ca.crt
TLS_CLIENT_CERT=/etc/proplet/client.crt
TLS_CLIENT_KEY=/etc/proplet/client.key
TLS_SKIP_VERIFY=false

# ============================================================================
# HEALTH CHECK
# ============================================================================

# Enable health check endpoint
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PORT=8080
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30

# ============================================================================
# METRICS (optional)
# ============================================================================

# Enable Prometheus metrics
METRICS_ENABLED=false
METRICS_PORT=9090
METRICS_PATH=/metrics
