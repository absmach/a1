# ============================================================================
# Proplet Configuration for BeagleV RISC-V
# ============================================================================
# IMPORTANT: Update PROPLET_MQTT_ADDRESS with your laptop's IP address!
# Example: tcp://192.168.1.100:1883 (where 192.168.1.100 is your laptop)
# ============================================================================

# ============================================================================
# PROPLET - Edge Worker Configuration
# ============================================================================

# Log level: trace, debug, info, warn, error
PROPLET_LOG_LEVEL=info

# Instance ID (leave empty for auto-generation or set unique ID)
PROPLET_INSTANCE_ID=""

# MQTT Broker Address - CRITICAL: UPDATE THIS!
# Format: tcp://YOUR_LAPTOP_IP:PORT
# Default SuperMQ MQTT port is 1883
# Example: tcp://192.168.1.100:1883
PROPLET_MQTT_ADDRESS="tcp://localhost:1883"

# MQTT Quality of Service (0, 1, or 2)
# 2 = exactly once delivery (recommended)
PROPLET_MQTT_QOS=2

# MQTT connection timeout
PROPLET_MQTT_TIMEOUT=30s

# Liveliness interval - how often proplet sends heartbeat
PROPLET_LIVELINESS_INTERVAL="10s"

# SuperMQ Domain ID (get from SuperMQ setup)
PROPLET_DOMAIN_ID=""

# SuperMQ Channel ID (get from SuperMQ setup)
PROPLET_CHANNEL_ID=""

# SuperMQ Client credentials
# These must match what you configured in SuperMQ
PROPLET_CLIENT_ID=""
PROPLET_CLIENT_KEY=""

# External WebAssembly runtime
# Options: "wasmtime" (default for BeagleV)
PROPLET_EXTERNAL_WASM_RUNTIME="wasmtime"

