config BR2_PACKAGE_PROPLET
	bool "proplet"
	depends on BR2_PACKAGE_HOST_GO_TARGET_ARCH_SUPPORTS
	depends on BR2_PACKAGE_HOST_GO_TARGET_CGO_LINKING_SUPPORTS
	depends on BR2_USE_WCHAR
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_WASMTIME
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_CA_CERTIFICATES
	help
	  Proplet is the edge worker runtime for Propeller WebAssembly
	  orchestration. It connects to SuperMQ services running on a
	  separate server (your laptop) and executes WASM workloads
	  using Wasmtime.
	  
	  This package includes ONLY the proplet binary and Wasmtime.
	  SuperMQ and other Propeller services must run elsewhere.
	  
	  Configuration:
	  Edit /etc/proplet/proplet.env to set your laptop's IP address
	  and SuperMQ connection details.

	  https://github.com/absmach/propeller

comment "proplet needs wchar, threads, and CGO support"
	depends on !BR2_USE_WCHAR || !BR2_TOOLCHAIN_HAS_THREADS \
		|| !BR2_PACKAGE_HOST_GO_TARGET_CGO_LINKING_SUPPORTS
        