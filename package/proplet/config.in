config BR2_PACKAGE_PROPLET
	bool "proplet"
	depends on BR2_PACKAGE_HOST_GO_TARGET_ARCH_SUPPORTS
	depends on BR2_PACKAGE_HOST_GO_TARGET_CGO_LINKING_SUPPORTS
	help
	  Proplet is a lightweight agent for managing and monitoring
	  edge devices as part of the Propeller system.

	  https://github.com/absmach/propeller

comment "proplet needs a toolchain w/ CGO support"
	depends on !BR2_PACKAGE_HOST_GO_TARGET_CGO_LINKING_SUPPORTS