config BR2_PACKAGE_WASMTIME
	bool "wasmtime"
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_USE_WCHAR
	depends on BR2_INSTALL_LIBSTDCPP
	help
	  Wasmtime is a fast, secure WebAssembly runtime.
	  
	  This package builds both the CLI tool and the C API library
	  for embedding in applications like Proplet.
	  
	  Note: Building Wasmtime from source on RISC-V takes 1-3 hours.

	  https://wasmtime.dev/

comment "wasmtime needs wchar, threads, C++, and Rust support"
	depends on !BR2_USE_WCHAR || !BR2_TOOLCHAIN_HAS_THREADS \
		|| !BR2_INSTALL_LIBSTDCPP \
		|| !BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
		