# ============================================================================
# BeagleV Proplet Configuration - Minimal Edge Worker
# ============================================================================

# Architecture
BR2_riscv=y
BR2_RISCV_64=y
BR2_RISCV_ISA_RVC=y

# System
BR2_SYSTEM_HOSTNAME="proplet-beaglev"
BR2_SYSTEM_BANNER="Propeller Proplet Edge Worker"
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PROPELLER_PATH)/board/beaglev/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_PROPELLER_PATH)/board/beaglev/post-build.sh"

# Toolchain
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y
BR2_GCC_VERSION_13_X=y

# Linux Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6"
BR2_LINUX_KERNEL_DEFCONFIG="defconfig"
BR2_LINUX_KERNEL_DTS_SUPPORT=y

# Init system
BR2_INIT_SYSTEMD=y
BR2_PACKAGE_SYSTEMD_NETWORKD=y
BR2_PACKAGE_SYSTEMD_RESOLVED=y

# Build tools
BR2_PACKAGE_HOST_GO=y
BR2_PACKAGE_HOST_RUSTC=y
BR2_PACKAGE_HOST_PKGCONF=y

# Core libraries (minimal)
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y

# Propeller packages
BR2_PACKAGE_WASMTIME=y
BR2_PACKAGE_PROPLET=y

# Networking
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_ETHTOOL=y

# Debugging tools (optional, remove for production)
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_HTOP=y

# Filesystem
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"

# Optimization
BR2_OPTIMIZE_2=y
BR2_ENABLE_DEBUG=y
