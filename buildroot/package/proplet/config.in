config BR2_PACKAGE_PROPLET
	bool "proplet"
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	select BR2_PACKAGE_HOST_RUSTC
	help
	  Proplet is a lightweight worker service that executes
	  WebAssembly workloads on edge devices. Written in Rust.

	  https://github.com/absmach/propeller

comment "proplet needs a Rust toolchain"
	depends on !BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS